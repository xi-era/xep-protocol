{
  "name": "@xi-era/xep-core",
  "version": "1.0.0",
  "description": "XEP (Xi-Era Protocol) 曦时代协议 TypeScript 参考实现 — ACP 之上的分布式多 Agent 协同语义层",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./persistence": { "types": "./dist/persistence/index.d.ts", "default": "./dist/persistence/index.js" },
    "./security/ed25519": { "types": "./dist/security/ed25519-signer.d.ts", "default": "./dist/security/ed25519-signer.js" }
  },
  "files": ["dist", "CHANGELOG.md"],
  "peerDependencies": {
    "@xi-era/acp-sdk": ">=0.1.0",
    "@noble/ed25519": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@xi-era/acp-sdk": { "optional": true },
    "@noble/ed25519": { "optional": true }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "npm run build && node ../examples/offline-goal-demo/demo.mjs",
    "demo:ws": "npm run build && node ../examples/offline-goal-demo/demo-ws.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@noble/ed25519": "^3.2.0",
    "@types/node": "^26.4.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
